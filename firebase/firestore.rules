rules_version = '2';
// SOS110 lecture data. Keep the admin email in sync with shared/firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Anonymous (student) tokens carry no email claims, so read them with a default:
    // a missing claim would otherwise make the whole rule fail.
    function verified() { return signedIn() && request.auth.token.get('email_verified', false) == true; }
    function isAdmin() { return verified() && request.auth.token.get('email', '') in ['mshrest1@asu.edu']; }
    // Students check in with a name and email over an anonymous sign-in (no account).
    function isStudent() { return signedIn() && !isAdmin(); }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    // Student records are shown to the instructor, so keep them small and typed.
    function shortText(v) { return v is string && v.size() <= 120; }
    function stamped() { return request.resource.data.at == request.time; }
    function isEmail(v) { return shortText(v) && v.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$'); }

    match /lectures/{lecture} {
      // Which poll is open. Students only need to read it.
      allow read: if isStudent() || isAdmin();
      allow write: if isAdmin();

      // Today's attendance code: never readable by students.
      match /private/{doc} {
        allow read, write: if isAdmin();
      }

      // A student checks in only with the current code and only as their own
      // browser's uid. Name and email are typed in by the student.
      match /attendance/{uid} {
        allow create, update: if isStudent() && owns(uid)
          && request.resource.data.keys().hasOnly(['name', 'email', 'code', 'at'])
          && shortText(request.resource.data.name) && request.resource.data.name.size() > 0
          && isEmail(request.resource.data.email)
          && stamped()
          && request.resource.data.code == get(/databases/$(database)/documents/lectures/$(lecture)/private/code).data.code;
        allow read, delete: if isAdmin();
      }

      // One vote per poll per student; students may change their answer.
      match /votes/{id} {
        allow create, update: if isStudent() && id == request.resource.data.poll + '__' + request.auth.uid
          && request.resource.data.keys().hasOnly(['poll', 'choice', 'uid', 'at'])
          && shortText(request.resource.data.poll)
          && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice < 10
          && request.resource.data.uid == request.auth.uid
          && stamped();
        allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow delete: if isAdmin();
      }

      // Simulation results, same pattern as votes.
      match /sims/{id} {
        allow create, update: if isStudent() && id == request.resource.data.sim + '__' + request.auth.uid
          && request.resource.data.keys().hasOnly(['sim', 'uid', 'name', 'data', 'at'])
          && shortText(request.resource.data.sim)
          && shortText(request.resource.data.name)
          && request.resource.data.data is map
          && request.resource.data.uid == request.auth.uid
          && stamped();
        allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow delete: if isAdmin();
      }
    }
  }
}
